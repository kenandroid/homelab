# Copy this to .env for local testing (never commit .env)
# All of these must also be added as Gitea repository secrets

# Jira (Atlassian Cloud)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token

# Jira Custom Field IDs (find these in Jira > Project Settings > Fields)
JIRA_FIELD_TARGET_PROJECT_KEY=customfield_XXXXX
JIRA_FIELD_REPO_NAME=customfield_XXXXX

# HLP project key
HLP_PROJECT_KEY=HLP

# Gitea
GITEA_BASE_URL=https://your-gitea-instance.example.com
GITEA_TOKEN=your_gitea_personal_access_token
GITEA_ORG=your-org-name

# Claude
ANTHROPIC_API_KEY=sk-ant-...

# Project → Repo mapping (one per project you onboard)
# PROJECT_REPO_MAP_MYPROJECT=my-gitea-repo-name
# PROJECT_REPO_MAP_ANOTHER=another-repo-name

# Confluence (used by arch_reviewer for final docs)
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=YOUR_SPACE

# Optional: override workspace dir for cloned repos
# AGENT_WORKSPACE=/tmp/agent-workspace
